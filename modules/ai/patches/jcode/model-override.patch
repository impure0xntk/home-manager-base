+        // `[provider].default_model` because only an explicit `--provider` is
+        // carried across that rebuild. The client already speaks
+        // `Request::SetModel` to the session it attached to -- the request the
+        // in-TUI `/model` command sends -- so send it here. Between Subscribe and
+        // GetHistory means the first History already describes the requested model
+        // instead of flashing the server default and correcting it. Reconnect and
+        // reload paths run this again, which is the right repeat: the override
+        // describes this launch, not this connection, and a re-exec'd daemon
+        // reloads `config.toml`.
+        if let Some(model) = std::env::var("JCODE_CLIENT_MODEL_OVERRIDE")
+            .ok()
+            .filter(|model| !model.trim().is_empty())
+        {
+            if let Err(error) = conn.set_model(model.trim()).await {
+                crate::logging::error(&format!(
+                    "Client --model override rejected by the server: {}",
+                    error
+                ));
+            }
+        }
