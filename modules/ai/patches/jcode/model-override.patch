diff --git a/crates/jcode-tui/src/tui/backend.rs b/crates/jcode-tui/src/tui/backend.rs
--- a/crates/jcode-tui/src/tui/backend.rs
+++ b/crates/jcode-tui/src/tui/backend.rs
@@ -529,4 +529,22 @@
         conn.next_request_id += 1;
 
+        // The client's `--model` override describes the session this process
+        // opens. Send it between `Subscribe` and `GetHistory` so the first
+        // `History` already describes the requested model instead of rendering
+        // the server default and correcting it. Reconnect and reload paths run
+        // this again on purpose: the override describes the launch, not the
+        // connection, and a re-exec'd daemon reloads `config.toml`.
+        if let Some(model) = std::env::var("JCODE_CLIENT_MODEL_OVERRIDE")
+            .ok()
+            .filter(|model| !model.trim().is_empty())
+        {
+            if let Err(error) = conn.set_model(model.trim()).await {
+                crate::logging::error(&format!(
+                    "Client --model override rejected by server: {}",
+                    error
+                ));
+            }
+        }
+
         // If resuming a session, the target-aware Subscribe attaches directly to
         // that session and returns History, so avoid a second bootstrap request.
diff --git a/src/cli/dispatch.rs b/src/cli/dispatch.rs
--- a/src/cli/dispatch.rs
+++ b/src/cli/dispatch.rs
@@ -756,4 +756,18 @@
         || args.model.is_some()
         || args.provider_profile.is_some();
+    // `--model` describes the session this process opens, and the flag is
+    // consumed here rather than by the daemon: a daemon that is already running
+    // was never told about it, and a daemon this process spawns rebuilds its
+    // provider for every new session, resetting a bare `--model` back to
+    // `[provider].default_model`. The client already speaks `Request::SetModel`
+    // to the session it attaches to, so hand the flag over that way.
+    let client_model_override = args
+        .model
+        .as_deref()
+        .map(str::trim)
+        .filter(|model| !model.is_empty());
+    if let Some(model) = client_model_override {
+        crate::env::set_var("JCODE_CLIENT_MODEL_OVERRIDE", model);
+    }
     let explicit_tool_options = args.tool_profile.is_some()
         || args.tools.is_some()
@@ -861,15 +875,16 @@
 
     if server_running && explicit_provider_or_model {
-        output::stderr_info(
-            "Server already running; provider/model flags only apply when starting a new server.",
-        );
-        output::stderr_info(format!(
-            "Current server settings control `/model`. Restart server to apply: --provider {}{}",
-            args.provider.as_arg_value(),
-            args.model
-                .as_ref()
-                .map(|m| format!(" --model {}", m))
-                .unwrap_or_default()
-        ));
+        if let Some(model) = client_model_override {
+            output::stderr_info(format!(
+                "Server already running; applying --model {model} to this session."
+            ));
+        }
+        // The provider is server-wide: chosen once at `serve` bootstrap, and
+        // every attached session inherits it. It still needs a restart.
+        if args.provider != ProviderChoice::Auto || args.provider_profile.is_some() {
+            output::stderr_info(
+                "Server already running; --provider/--provider-profile only apply to a new server. Current server settings control `/model`; restart the server to change provider.",
+            );
+        }
     }
 
